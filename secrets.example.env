# Voorbereiding voor de latere SQL-koppeling; de Go-app gebruikt dit nog niet.
# Vul pas waarden in zodra de database gekozen en ingericht is.
# Eén KEY=value per regel. Geen shell-expansie; quotes rond waarden zijn optioneel.
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Bestaande Google Web OAuth-client; geen client secret nodig.
GOOGLE_CLIENT_ID=
# Leeg: ieder geverifieerd Google-account mag inloggen. Geen beheerdersrechten.
ALLOWED_EMAILS=
